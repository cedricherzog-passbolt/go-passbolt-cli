# Resource share is currently blocked for the CLI's standard user: the CLI
# doesn't expose the SDK's MetadataKeyUpdatedCallback, so any flow that needs
# to (re-)trust the shared metadata key fails. Two server states produce this
# block, with slightly different errors:
#
#   - rotated key, user has stale trust ("metadata Key has changed")
#   - fresh key, user was never given a private-key copy ("no Metadata Private
#     key for our user")
#
# Either is fine for locking in "share blocked without trust-callback CLI
# support". When the CLI plumbs a --trustNewMetadataKey flag (or equivalent),
# the share will start succeeding and the negative assertion will fail,
# prompting a rewrite into a proper share roundtrip.

pb list user --json
cp stdout users.json
jsonget users.json [username=adele@passbolt.com].id ADELE_ID

pb create resource --type v5-default --name test-share-locked --password p --json
cp stdout resource.json
jsonget resource.json id RID
defer pb delete resource --id $RID

! pb share resource --id $RID --type 1 --user $ADELE_ID
stderr '(metadata Key has changed|no Metadata Private key)'
