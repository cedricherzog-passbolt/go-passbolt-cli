# User CRUD round-trip exercised entirely through the CLI. User create/update/
# delete are admin-only on the default Passbolt policy, so we drive the lifecycle
# as admin via `pba`. This is the only coverage of the user get/create/update/
# delete commands; the other suites create users via the server admin tooling.

[!env:HAS_ADMIN] skip 'admin config not available; user create requires admin'

# Create
pba create user --username rtuser@passbolt.com --firstname Round --lastname Trip --role user --json
cp stdout create.json
jsonexists create.json id
jsonget create.json id ID
defer pba delete user --id $ID

# Get reflects the created values
pba get user --id $ID --json
cp stdout get.json
jsoneq get.json username rtuser@passbolt.com
jsoneq get.json first_name Round
jsoneq get.json last_name Trip
jsonexists get.json role

# Update a single field; the others must be preserved
pba update user --id $ID --firstname Rounded

pba get user --id $ID --json
cp stdout updated.json
jsoneq updated.json first_name Rounded
jsoneq updated.json last_name Trip
jsoneq updated.json username rtuser@passbolt.com
