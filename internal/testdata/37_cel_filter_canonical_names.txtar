# CEL --filter accepts canonical snake_case variable names (matching JSON
# output) alongside the legacy PascalCase variables that existing scripts use.
# Part of #129's "same attribute names everywhere" goal.

pb create resource --type v5-default --name test-cel-naming --username cel-naming-user --uri https://cel-naming.example.com --password cel-naming-pass --json
cp stdout create.json
jsonget create.json id RID
defer pb delete resource --id $RID

# Canonical snake_case CEL variable (the new behavior).
pb list resource --filter 'name == "test-cel-naming"' --json
stdout $RID

# Legacy PascalCase CEL variable still works (back-compat).
pb list resource --filter 'Name == "test-cel-naming"' --json
stdout $RID

# folder_parent_id (multi-word) canonical form.
pb list resource --filter 'folder_parent_id == ""' --json
stdout test-cel-naming

# FolderParentID PascalCase alias still works.
pb list resource --filter 'FolderParentID == ""' --json
stdout test-cel-naming

# Filter on a secret-bearing field via canonical name — must still trigger
# secret decryption (resourceSecretCelNames covers both canonical and alias).
pb list resource --filter 'password == "cel-naming-pass"' --json
stdout $RID

# Same for folder.
pb create folder --name test-cel-folder-naming --json
cp stdout folder.json
jsonget folder.json id FID
defer pb delete folder --id $FID

# Canonical snake_case CEL variable on folder.
pb list folder --filter 'name == "test-cel-folder-naming"' --json
stdout $FID

# Legacy PascalCase CEL variable on folder.
pb list folder --filter 'Name == "test-cel-folder-naming"' --json
stdout $FID
