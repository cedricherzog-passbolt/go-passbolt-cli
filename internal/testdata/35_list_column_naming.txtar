# --column accepts canonical snake_case and legacy PascalCase / lowercased-concat
# aliases identically in both table and JSON modes, and rejects unknown names
# in both modes. Regression for passbolt/go-passbolt-cli#129 — JSON output used
# to silently drop multi-word columns whose ToLower form (e.g. CreatedTimestamp
# → createdtimestamp) didn't match a JSON tag (created_timestamp).
#
# Multi-word existence checks use created_timestamp because it is always
# populated; jsonexists treats "" as absent, and folder_parent_id is "" for
# root-level resources.

pb create resource --type v5-default --name test-col-naming --username col-user --uri https://col.example.com --password col-pass --json
cp stdout create.json
jsonget create.json id ID
defer pb delete resource --id $ID

# JSON mode: canonical snake_case columns return values keyed by the canonical name.
pb list resource --column id --column name --column created_timestamp --json
cp stdout snake.json
jsoneq snake.json [id=$ID].name test-col-naming
jsonexists snake.json [id=$ID].created_timestamp
# Non-requested columns must be absent (proves --column filtering applied).
! jsonexists snake.json [id=$ID].username

# JSON mode: PascalCase aliases normalize to canonical names — JSON keys are
# still snake_case (this is the bug from #129: previously, CreatedTimestamp
# silently dropped because the strings.ToLower lookup hit "createdtimestamp",
# which doesn't exist as a JSON tag).
pb list resource --column ID --column Name --column CreatedTimestamp --json
cp stdout pascal.json
jsoneq pascal.json [id=$ID].name test-col-naming
jsonexists pascal.json [id=$ID].created_timestamp
! jsonexists pascal.json [id=$ID].username

# JSON mode: legacy lowercased-concat alias also normalizes — covers the
# `createdtimestamp` form which previously matched the table switch but
# silently dropped from JSON output. Include `id` in --column so [id=$ID]
# can locate our specific resource amid resources from parallel test scripts.
pb list resource --column id --column name --column createdtimestamp --json
cp stdout legacy.json
jsoneq legacy.json [id=$ID].name test-col-naming
jsonexists legacy.json [id=$ID].created_timestamp
! jsonexists legacy.json [id=$ID].username

# Table mode: canonical snake_case works (previously errored).
pb list resource --column id --column folder_parent_id --column name
stdout test-col-naming

# Table mode: PascalCase alias still works (back-compat).
pb list resource --column ID --column FolderParentID --column Name
stdout test-col-naming

# Unknown column errors consistently in both modes (previously: silently empty in JSON).
! pb list resource --column nope
stderr 'unknown column'
! pb list resource --column nope --json
stderr 'unknown column'
